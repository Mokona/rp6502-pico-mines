{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "llvm-mos-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "llvm-mos-sdk_DIR": "$env{HOME}/.rp6502/llvm-mos/lib/cmake/llvm-mos-sdk",
                "LLVM_MOS": "$env{HOME}/.rp6502/llvm-mos/bin",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "description": "cc65, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "description": "cc65, optimized",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "description": "llvm-mos, with debug information",
            "inherits": "llvm-mos-base",
            "binaryDir": "${sourceDir}/build/llvm-mos/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "description": "llvm-mos, optimized",
            "inherits": "llvm-mos-base",
            "binaryDir": "${sourceDir}/build/llvm-mos/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "basic",
            "displayName": "basic",
            "description": "BASIC",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/basic",
            "cacheVariables": {
                "RP6502_BASIC": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "targets": ["all"]
        },
        {
            "name": "basic",
            "displayName": "basic",
            "configurePreset": "basic",
            "targets": ["all"]
        }
    ]
}
